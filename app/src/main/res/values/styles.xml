<resources>
    <style name="AppTheme" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowActionBar">false</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:colorAccent">#7DD3FC</item>
        <item name="android:navigationBarColor">#061425</item>
        <item name="android:statusBarColor">#061425</item>
    </style>

    <style name="NoDisplayTheme" parent="android:style/Theme.NoDisplay">
        <item name="android:windowNoDisplay">true</item>
        <item name="android:windowDisablePreview">true</item>
    </style>

    <style name="DialogTheme" parent="android:style/Theme.Material.Dialog.Alert">
        <item name="android:colorAccent">#176B87</item>
    </style>
</resources>
